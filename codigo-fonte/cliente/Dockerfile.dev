FROM node:20-alpine

WORKDIR /app

# Copiar e configurar entrypoint primeiro
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Copiar arquivos de configuração
COPY package*.json ./

# Instalar dependências (será sobrescrito pelo volume se node_modules já existir)
RUN npm install

# Copiar código-fonte
COPY . .

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
